EVAL <- all(file.exists(file.path("fits", c(
  "mfrm_data.rds", "mfrm_truth.rds", "fit_mfrm_rsm.rds",
  "fit_mfrm_rsm_halo.rds", "fit_mfrm_rsm_scales.rds", "fit_mfrm_rm_halo.rds",
