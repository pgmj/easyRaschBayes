```{r setup, include = FALSE}
knitr::opts_chunk$set(
  collapse = TRUE,
  comment = "#>",
  fig.path = "figures/pcm-",
  fig.width = 8,
  fig.height = 5.5,
  dpi = 144,
  out.width = "100%",
  dev = "ragg_png"
)
# Only evaluate model-dependent chunks if the pre-fitted model exists
EVAL <- file.exists("fits/fit_pcm_phq9.rds") &&
  file.exists("fits/dif_gender_phq9.rds")
# The fit statistics use random subsets of draws and replicated data
set.seed(2024)
# Auto-numbered, journal-style figure captions, as in the easyRasch2
# vignette: every chunk with fig.cap = "..." gets the caption
# **Figure N.** *caption text* at knit time.
local({
  fig_n <- 0L
  knitr::opts_hooks$set(fig.cap = function(options) {
    cap <- options$fig.cap
    if (!is.null(cap) && nzchar(cap) && !grepl("^\\*\\*Figure ", cap)) {
      fig_n <<- fig_n + 1L
      options$fig.cap <- sprintf("**Figure %d.** *%s*", fig_n, cap)
    }
    options
  })
})
```

